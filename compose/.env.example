# Copy to .env and edit.
# The Matrix server name: the part after the colon in @user:server. It cannot be changed once the server has data.
MATRIX_SERVER_NAME=chat.example.org
# Required to create accounts (./register-user.sh): openssl rand -base64 24
REGISTRATION_TOKEN=
# The address people type into the browser (scheme + host [+ port])
PUBLIC_URL=http://localhost:8080
# ALLOW_FEDERATION=true
# TUWUNEL_IMAGE=ghcr.io/hugmesh/hugmesh-tuwunel:0.5.1-beta.1
# TUWUNEL_WEB_IMAGE=ghcr.io/hugmesh/hugmesh-tuwunel-web:0.5.1-beta.1
# WEB_PORT=8080
